{
  "name": "@bahulam/workplane-ui",
  "version": "0.1.0",
  "description": "Persistent interactive workspaces for people and agents \u2014 headless document authority with a React reference shell",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "keywords": [
    "workplane",
    "agent",
    "document",
    "generative-bi",
    "dashboard",
    "react",
    "headless",
    "echarts",
    "three"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BahulamAI/workplane-ui.git"
  },
  "homepage": "https://github.com/BahulamAI/workplane-ui#readme",
  "bugs": {
    "url": "https://github.com/BahulamAI/workplane-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./echarts": {
      "types": "./dist/echarts.d.ts",
      "default": "./dist/echarts.js"
    },
    "./bahulam": {
      "types": "./dist/bahulam.d.ts",
      "default": "./dist/bahulam.js"
    },
    "./testkit": {
      "types": "./dist/testkit.d.ts",
      "default": "./dist/testkit.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./diagram": {
      "types": "./dist/diagram.d.ts",
      "default": "./dist/diagram.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "default": "./dist/three.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b && cp src/react/styles.css dist/styles.css",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "peerDependencies": {
    "echarts": "^5.5.0",
    "mermaid": "^11.0.0 || ^12.0.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "echarts": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.186.0",
    "echarts": "^5.5.1",
    "mermaid": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1",
    "typescript": "^5.7.2"
  }
}
