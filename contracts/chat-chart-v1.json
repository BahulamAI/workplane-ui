{
  "contract_version": "workplane.chat-chart/1",
  "renderer": "workplane.echarts.chat",
  "themes": [
    "default",
    "minimal",
    "presentation",
    "high_contrast"
  ],
  "presentations": [
    {
      "types": [
        "bar",
        "horizontal_bar"
      ],
      "purpose": "Compare categories; use horizontal bars for long labels.",
      "status": "supported"
    },
    {
      "types": [
        "lollipop"
      ],
      "purpose": "Compare categories with a lighter visual weight than full bars; single series only.",
      "status": "supported"
    },
    {
      "types": [
        "dumbbell"
      ],
      "purpose": "Show the distance between exactly two measurements per category, e.g. before vs after or target vs actual; needs exactly two named series.",
      "status": "supported"
    },
    {
      "types": [
        "line",
        "area",
        "step_line"
      ],
      "purpose": "Show ordered trends; use area to emphasize magnitude, step for values that change in discrete jumps rather than continuously.",
      "status": "supported"
    },
    {
      "types": [
        "range_area"
      ],
      "purpose": "Show an uncertainty band or min/max range around a trend; each series needs a low and high value per x, not a single y.",
      "status": "supported"
    },
    {
      "types": [
        "stacked_bar",
        "stacked_area"
      ],
      "purpose": "Show how multiple nonnegative series contribute to a total.",
      "status": "supported"
    },
    {
      "types": [
        "stacked_bar_100",
        "stacked_area_100"
      ],
      "purpose": "Show what share each nonnegative series contributes to a total, normalized to 100% so proportions are comparable across categories of different absolute size.",
      "status": "supported"
    },
    {
      "types": [
        "sparkline"
      ],
      "purpose": "Show a trend at a glance with no axes or legend; for inline/compact scanning, not precise reading.",
      "status": "supported"
    },
    {
      "types": [
        "pie",
        "donut"
      ],
      "purpose": "Show nonnegative parts of a whole, preferably 2–6 categories.",
      "status": "supported"
    },
    {
      "types": [
        "rose"
      ],
      "purpose": "Like pie, but each slice's radius scales with its value instead of just its angle, which emphasizes magnitude differences more strongly; nonnegative.",
      "status": "supported"
    },
    {
      "types": [
        "pareto"
      ],
      "purpose": "Rank nonnegative categories by contribution and overlay cumulative percentage to find the vital few; single series only.",
      "status": "supported"
    },
    {
      "types": [
        "waterfall"
      ],
      "purpose": "Show a running total through a sequence of signed increases and decreases; single series where each point is a delta from the previous total, not an absolute value.",
      "status": "supported"
    },
    {
      "types": [
        "funnel",
        "pyramid"
      ],
      "purpose": "Show a nonnegative quantity narrowing (funnel) or widening (pyramid) through ordered stages.",
      "status": "supported"
    },
    {
      "types": [
        "waffle"
      ],
      "purpose": "Show nonnegative parts of a whole as a 10x10 grid of unit squares, one block per percentage point; best for one proportion at a glance, not precise multi-way comparison.",
      "status": "supported"
    },
    {
      "types": [
        "error_bar"
      ],
      "purpose": "Show a measurement plus its uncertainty range; like range_area but for a single point per x rather than a continuous band. Give low/high (and an explicit value if the drawn point is not their midpoint).",
      "status": "supported"
    },
    {
      "types": [
        "scatter"
      ],
      "purpose": "Show relationships between two numeric measurements; use numeric x/y points.",
      "status": "supported"
    },
    {
      "types": [
        "histogram"
      ],
      "purpose": "Show the distribution of one sample of raw numeric observations, auto-binned into equal-width bins; single series only.",
      "status": "supported"
    },
    {
      "types": [
        "box_plot"
      ],
      "purpose": "Show the five-number summary (min, quartiles, max) of one or more named samples of raw observations, for comparing distributions across groups.",
      "status": "supported"
    },
    {
      "types": [
        "density"
      ],
      "purpose": "Show a smoothed estimate of the distribution shape of one or more named samples, as a continuous curve rather than discrete bins.",
      "status": "supported"
    },
    {
      "types": [
        "ecdf"
      ],
      "purpose": "Show what fraction of a sample falls at or below each value, as a nondecreasing step curve from 0 to 1; good for comparing whole distributions without binning.",
      "status": "supported"
    },
    {
      "types": [
        "strip_plot"
      ],
      "purpose": "Show every raw observation of one or more named samples as points along one lane per sample, with no binning or smoothing.",
      "status": "supported"
    },
    {
      "types": [
        "beeswarm"
      ],
      "purpose": "Like strip_plot, but spreads overlapping points sideways within local density bins so individual observations stay visible rather than stacking on top of each other.",
      "status": "supported"
    }
  ],
  "limits": {
    "max_points": 2000,
    "max_series": 12,
    "max_bytes": 64000
  },
  "instructions": "Use render_chart with computed values. Do not invent data. Use render_table for exact values and render_kpi_cards for headline numbers. No code, callbacks, remote URLs or executable specifications.",
  "tool_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "chart_type",
      "series"
    ],
    "properties": {
      "chart_type": {
        "type": "string",
        "enum": [
          "bar",
          "horizontal_bar",
          "lollipop",
          "dumbbell",
          "stacked_bar",
          "stacked_bar_100",
          "line",
          "area",
          "step_line",
          "range_area",
          "error_bar",
          "stacked_area",
          "stacked_area_100",
          "sparkline",
          "pie",
          "donut",
          "rose",
          "pareto",
          "waterfall",
          "funnel",
          "pyramid",
          "waffle",
          "scatter",
          "histogram",
          "box_plot",
          "density",
          "ecdf",
          "strip_plot",
          "beeswarm"
        ]
      },
      "title": {
        "type": "string",
        "maxLength": 300
      },
      "x_label": {
        "type": "string",
        "maxLength": 300
      },
      "y_label": {
        "type": "string",
        "maxLength": 300
      },
      "series": {
        "type": "array",
        "minItems": 1,
        "maxItems": 500,
        "items": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "value"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "maxLength": 300
                },
                "value": {
                  "type": "number"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "points"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 300
                },
                "points": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 500,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y"
                    ],
                    "properties": {
                      "x": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 300
                          },
                          {
                            "type": "number"
                          }
                        ]
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "points"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 300
                },
                "points": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 500,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "low",
                      "high"
                    ],
                    "properties": {
                      "x": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 300
                          },
                          {
                            "type": "number"
                          }
                        ]
                      },
                      "low": {
                        "type": "number"
                      },
                      "high": {
                        "type": "number"
                      },
                      "value": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "values"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 300
                },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 2000,
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          ]
        }
      },
      "observations": {
        "type": "array",
        "maxItems": 6,
        "items": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "theme": {
        "type": "string",
        "enum": [
          "default",
          "minimal",
          "presentation",
          "high_contrast"
        ]
      },
      "appearance": {
        "type": "string",
        "enum": [
          "auto",
          "light",
          "dark"
        ]
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "chart_type": {
              "not": {
                "enum": [
                  "range_area",
                  "error_bar",
                  "histogram",
                  "box_plot",
                  "density",
                  "ecdf",
                  "strip_plot",
                  "beeswarm"
                ]
              }
            }
          },
          "required": [
            "chart_type"
          ]
        },
        "then": {
          "properties": {
            "series": {
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label",
                      "value"
                    ],
                    "properties": {
                      "label": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "value": {
                        "type": "number"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "points"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "points": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 500,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "x",
                            "y"
                          ],
                          "properties": {
                            "x": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "maxLength": 300
                                },
                                {
                                  "type": "number"
                                }
                              ]
                            },
                            "y": {
                              "type": "number"
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "chart_type": {
              "enum": [
                "stacked_bar_100",
                "stacked_area_100",
                "pareto",
                "funnel",
                "pyramid",
                "rose",
                "waffle"
              ]
            }
          },
          "required": [
            "chart_type"
          ]
        },
        "then": {
          "properties": {
            "series": {
              "items": {
                "properties": {
                  "value": {
                    "minimum": 0
                  },
                  "points": {
                    "items": {
                      "properties": {
                        "y": {
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "chart_type": {
              "enum": [
                "pareto",
                "waterfall"
              ]
            }
          },
          "required": [
            "chart_type"
          ]
        },
        "then": {
          "properties": {
            "series": {
              "anyOf": [
                {
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label",
                      "value"
                    ],
                    "properties": {
                      "label": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "value": {
                        "type": "number"
                      }
                    }
                  }
                },
                {
                  "maxItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "points"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "points": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 500,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "x",
                            "y"
                          ],
                          "properties": {
                            "x": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "maxLength": 300
                                },
                                {
                                  "type": "number"
                                }
                              ]
                            },
                            "y": {
                              "type": "number"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "chart_type": {
              "enum": [
                "range_area",
                "error_bar"
              ]
            }
          },
          "required": [
            "chart_type"
          ]
        },
        "then": {
          "properties": {
            "series": {
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "points"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "points": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "x",
                        "low",
                        "high"
                      ],
                      "properties": {
                        "x": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 300
                            },
                            {
                              "type": "number"
                            }
                          ]
                        },
                        "low": {
                          "type": "number"
                        },
                        "high": {
                          "type": "number"
                        },
                        "value": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "chart_type": {
              "enum": [
                "histogram",
                "box_plot",
                "density",
                "ecdf",
                "strip_plot",
                "beeswarm"
              ]
            }
          },
          "required": [
            "chart_type"
          ]
        },
        "then": {
          "properties": {
            "series": {
              "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "values"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "values": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 2000,
                    "items": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "chart_type": {
              "const": "histogram"
            }
          },
          "required": [
            "chart_type"
          ]
        },
        "then": {
          "properties": {
            "series": {
              "maxItems": 1
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "chart_type": {
              "const": "dumbbell"
            }
          },
          "required": [
            "chart_type"
          ]
        },
        "then": {
          "properties": {
            "series": {
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "points"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "points": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "x",
                        "y"
                      ],
                      "properties": {
                        "x": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 300
                            },
                            {
                              "type": "number"
                            }
                          ]
                        },
                        "y": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "chart_type": {
              "const": "lollipop"
            }
          },
          "required": [
            "chart_type"
          ]
        },
        "then": {
          "properties": {
            "series": {
              "anyOf": [
                {
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label",
                      "value"
                    ],
                    "properties": {
                      "label": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "value": {
                        "type": "number"
                      }
                    }
                  }
                },
                {
                  "maxItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "points"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "points": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 500,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "x",
                            "y"
                          ],
                          "properties": {
                            "x": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "maxLength": 300
                                },
                                {
                                  "type": "number"
                                }
                              ]
                            },
                            "y": {
                              "type": "number"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    ]
  }
}
